# --- LLM provider keys (set the ones you want enabled) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Default chat model (provider:model) ---
DEFAULT_MODEL=anthropic:claude-sonnet-4-20250514

# --- Postgres ---
POSTGRES_USER=llm
POSTGRES_PASSWORD=llm
POSTGRES_DB=llm_logs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (event bus) ---
REDIS_URL=redis://redis:6379

# --- Ingestion ---
INGESTION_URL=http://ingestion:4000
INGESTION_TOKEN=dev-ingestion-token
LOG_STREAM=inference.logs

# --- Chatbot backend ---
CHATBOT_PORT=3001

# --- Frontend ---
VITE_API_BASE=http://localhost:3001
